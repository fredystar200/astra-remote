{
  "name": "astra-remote",
  "version": "1.0.0",
  "description": "Mobile web remote control for Astra music player",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "pkg . --out-path dist --compress GZip",
    "build:win": "pkg . --targets node18-win-x64 --out-path dist --compress GZip",
    "build:mac": "pkg . --targets node18-mac-x64 --out-path dist --compress GZip",
    "build:linux": "pkg . --targets node18-linux-x64 --out-path dist --compress GZip"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node18-win-x64",
      "node18-mac-x64",
      "node18-linux-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
